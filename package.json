{
  "name": "hermes-terminal-face",
  "version": "1.2.0",
  "description": "Ghostty custom-shader terminal face for Hermes Agent, Pi, Grok Build and Antigravity CLI \u2014 mirrors the agent's working state to the OSC 12 cursor color.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sashimi3433/hermes-terminal-face.git"
  },
  "keywords": [
    "pi-package",
    "ghostty",
    "terminal",
    "shader",
    "hermes-agent"
  ],
  "pi": {
    "extensions": [
      "./extensions/terminal-face.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/terminal-face.test.ts",
    "test:hooks": "python3 -m unittest discover -s test -p 'test_*.py'"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
